{
  "info": {
    "name": "FireGuard API",
    "description": "FireGuard gateway and internal service smoke-test requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway_url", "value": "http://localhost:8090" },
    { "key": "intake_url", "value": "http://localhost:8004" },
    { "key": "retrieval_url", "value": "http://localhost:8001" },
    { "key": "compliance_url", "value": "http://localhost:8002" },
    { "key": "report_url", "value": "http://localhost:8003" },
    { "key": "username", "value": "admin" },
    { "key": "email", "value": "student@sliit.lk" },
    { "key": "password", "value": "StrongPassword123!" },
    { "key": "registration_plan", "value": "basic" },
    { "key": "expected_plan", "value": "basic" },
    { "key": "purchase_plan", "value": "basic" },
    { "key": "access_token", "value": "" },
    { "key": "checkout_id", "value": "" },
    { "key": "pdf_file", "value": "" },
    { "key": "session_id", "value": "" }
  ],
  "item": [
    {
      "name": "Gateway - Client API",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/health"
          }
        },
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration succeeded', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('expected_plan', json.plan);",
                  "if (json.checkout_id) pm.collectionVariables.set('checkout_id', json.checkout_id); else pm.collectionVariables.unset('checkout_id');",
                  "pm.test('Selected plan returned', function () { pm.expect(json.plan).to.eql(pm.collectionVariables.get('registration_plan')); });",
                  "if (json.checkout_id) pm.test('Mock payment details returned', function () { pm.expect(json.amount).to.be.a('number'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"plan\": \"{{registration_plan}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{gateway_url}}/auth/register"
          }
        },
        {
          "name": "Login - Get JWT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('access_token', json.access_token);",
                  "pm.test('JWT token saved', function () { pm.expect(json.access_token).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "{{username}}", "type": "text" },
                { "key": "password", "value": "{{password}}", "type": "text" }
              ]
            },
            "url": "{{gateway_url}}/auth/token"
          }
        },
        {
          "name": "Complete Registration Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration payment completed', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('expected_plan', json.plan);",
                  "pm.test('Registered plan activated', function () { pm.expect(json.plan).to.eql(pm.collectionVariables.get('registration_plan')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"checkout_id\": \"{{checkout_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{gateway_url}}/billing/mock/confirm"
          }
        },
        {
          "name": "Account - Current Plan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Account lookup succeeded', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Expected plan is visible', function () { pm.expect(json.plan).to.eql(pm.collectionVariables.get('expected_plan')); });",
                  "pm.test('Plan is supported', function () { pm.expect(['student', 'basic', 'pro', 'enterprise', 'government']).to.include(json.plan); });",
                  "pm.test('Reports remaining has the expected type', function () { pm.expect(json.reports_remaining === null || typeof json.reports_remaining === 'number').to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": "{{gateway_url}}/account/me"
          }
        },
        {
          "name": "Mock Checkout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Checkout created', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('checkout_id', json.checkout_id);",
                  "pm.test('Checkout ID saved', function () { pm.expect(json.checkout_id).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plan\": \"{{purchase_plan}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{gateway_url}}/billing/mock/checkout"
          }
        },
        {
          "name": "Mock Payment Confirm",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Mock payment completed', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('expected_plan', json.plan);",
                  "pm.test('Purchased plan activated', function () { pm.expect(json.plan).to.eql(pm.collectionVariables.get('purchase_plan')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"checkout_id\": \"{{checkout_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{gateway_url}}/billing/mock/confirm"
          }
        },
        {
          "name": "Analyze Text - Full Report",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.report && json.report.session_id) pm.collectionVariables.set('session_id', json.report.session_id);",
                  "pm.test('Analysis request completed', function () { pm.expect(pm.response.code).to.be.oneOf([200, 502, 503]); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"raw_prompt\": \"A five-storey hospital has reinforced concrete walls, gypsum board partitions, 5kg ABC fire extinguishers on every floor near stairwell entrances, a protected escape stairwell, and a flammable liquid storage room.\",\n  \"building_name\": \"Postman Text Hospital\",\n  \"auditor_notes\": \"Assess fire safety compliance and identify missing measurements.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{gateway_url}}/analyze/text"
          }
        },
        {
          "name": "Analyze PDF - Full Report",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.report && json.report.session_id) pm.collectionVariables.set('session_id', json.report.session_id);",
                  "const expectedPlan = pm.collectionVariables.get('expected_plan');",
                  "pm.test('PDF access matches the selected plan', function () {",
                  "  if (expectedPlan === 'student') pm.expect(pm.response.code).to.eql(403);",
                  "  else pm.expect(pm.response.code).to.be.oneOf([200, 502, 503]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "{{pdf_file}}" },
                { "key": "building_name", "value": "Postman PDF Hospital", "type": "text" },
                { "key": "auditor_notes", "value": "Assess fire safety compliance and identify missing measurements.", "type": "text" }
              ]
            },
            "url": "{{gateway_url}}/analyze"
          }
        }
      ]
    },
    {
      "name": "Service Health Checks",
      "item": [
        {
          "name": "Intake Health",
          "request": { "method": "GET", "header": [], "url": "{{intake_url}}/health" }
        },
        {
          "name": "Retrieval Health",
          "request": { "method": "GET", "header": [], "url": "{{retrieval_url}}/health" }
        },
        {
          "name": "Compliance Health",
          "request": { "method": "GET", "header": [], "url": "{{compliance_url}}/health" }
        },
        {
          "name": "Report Health",
          "request": { "method": "GET", "header": [], "url": "{{report_url}}/health" }
        },
        {
          "name": "Retrieval Dense Health",
          "request": { "method": "GET", "header": [], "url": "{{retrieval_url}}/health/dense" }
        },
        {
          "name": "Retrieval Sparse Health",
          "request": { "method": "GET", "header": [], "url": "{{retrieval_url}}/health/sparse" }
        },
        {
          "name": "Compliance All Dependencies",
          "request": { "method": "GET", "header": [], "url": "{{compliance_url}}/health/all" }
        },
        {
          "name": "Report All Dependencies",
          "request": { "method": "GET", "header": [], "url": "{{report_url}}/health/all" }
        }
      ]
    }
  ]
}
