JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
INTERNAL_API_KEY=replace-with-the-api-key-configured-in-report-service
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

POSTGRES_DB=fireguard
POSTGRES_USER=fireguard
POSTGRES_PASSWORD=replace-with-a-long-password
DATABASE_URL=postgresql://fireguard:replace-with-a-long-password@postgres:5432/fireguard

GROQ_API_KEY=replace-me
GEMINI_API_KEY=replace-me
UPLOAD_ENCRYPTION_KEY=replace-with-fernet-key
SIGNING_SECRET=replace-with-at-least-32-random-characters
API_KEYS=["gateway:<sha256-of-INTERNAL_API_KEY>"]

CHROMA_HOST=chromadb
CHROMA_PORT=8000
MCP_HTTP_ENABLED=true
